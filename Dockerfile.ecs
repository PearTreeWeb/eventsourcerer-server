# Production Dockerfile for Amazon ECS
FROM dunglas/frankenphp:1-builder-php8.5-bookworm AS builder

# Copy xcaddy in the builder image
COPY --from=caddy:builder /usr/bin/xcaddy /usr/bin/xcaddy

# CGO must be enabled to build FrankenPHP
RUN export CGO_ENABLED=1 \
    GOSUMDB=off \
    XCADDY_SETCAP=1 \
    XCADDY_GO_BUILD_FLAGS="-ldflags='-w -s' -trimpath -tags=nobadger,nomysql,nopgx" \
    CGO_CFLAGS=$(php-config --includes) \
    CGO_LDFLAGS="$(php-config --ldflags) $(php-config --libs)" \
    && for i in 1 2 3 4 5; do \
        GOPROXY=https://proxy.golang.org,direct \
        GOFLAGS=-mod=mod \
        xcaddy build \
            --output /usr/local/bin/frankenphp \
            --with github.com/dunglas/frankenphp=./ \
            --with github.com/dunglas/frankenphp/caddy=./caddy/ \
            --with github.com/baldinof/caddy-supervisor \
        && break || { echo "xcaddy build failed (attempt $i), retrying with GOPROXY=direct..."; GOPROXY=direct xcaddy build --output /usr/local/bin/frankenphp --with github.com/dunglas/frankenphp=./ --with github.com/dunglas/frankenphp/caddy=./caddy/ --with github.com/baldinof/caddy-supervisor && break || sleep 5; }; \
    done

FROM dunglas/frankenphp:php8.5-bookworm AS runner

# Set environment variables
ENV APP_ENV=prod
ENV FRANKENPHP_CONFIG="import /etc/frankenphp/Caddyfile"

COPY --from=builder /usr/local/bin/frankenphp /usr/local/bin/frankenphp

RUN for i in 1 2 3 4 5; do \
        rm -rf /var/lib/apt/lists/* && \
        apt-get -o Acquire::Max-FutureTime=86400 -o Acquire::Check-Valid-Until=false -o Acquire::AllowInsecureRepositories=true -o Acquire::AllowDowngradeToInsecureRepositories=true update --fix-missing && break || { echo "apt-get update failed (attempt $i), retrying..."; sleep 5; }; \
    done \
    && apt-get install -y --no-install-recommends --allow-unauthenticated \
    acl \
    build-essential \
    libpq-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libxslt1-dev \
    libmagickwand-dev \
    librabbitmq-dev \
    libicu-dev \
    unzip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /tmp/* /var/tmp/*

# Install PHP extensions
RUN install-php-extensions \
    pdo_pgsql \
    redis \
    amqp \
    gd \
    intl \
    zip \
    opcache \
    bcmath \
    exif \
    pcntl \
    xsl \
    soap

# Copy Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Copy application source code
COPY . .

# Install dependencies
RUN composer install --no-dev --optimize-autoloader

# Set permissions
RUN chown -R www-data:www-data var public/uploads 2>/dev/null || true
RUN chmod -R 775 var public/uploads 2>/dev/null || true

# Copy production Caddyfile
COPY docker/php/Caddyfile.ecs /etc/frankenphp/Caddyfile

# Copy entrypoint script
COPY docker/php/entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

# ECS specific: Use a fixed port if needed, or rely on env var
EXPOSE 80
EXPOSE 443
EXPOSE 1984

ENTRYPOINT ["docker-entrypoint"]

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
