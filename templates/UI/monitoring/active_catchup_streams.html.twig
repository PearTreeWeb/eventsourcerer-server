<turbo-frame id="active-catchup-streams">
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm min-h-40 h-full">
        {% include 'UI/widget/template_header.html.twig' with {icon: 'fa-lock', name: 'Active Catchup Streams'} %}
        <div class="p-5">
            <table class="table-auto text-xs w-full text-slate-400">
                <tbody>
                    {% for activeCatchupStream in activeCatchupStreams %}
                        <tr class="even:bg-gray-50 hover:bg-gray-200">
                            <td class="py-2">{{ activeCatchupStream }}</td>
                        </tr>
                    {% else %}
                        <tr><td class="py-2">No streams being read currently as part of a catchup</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</turbo-frame>
