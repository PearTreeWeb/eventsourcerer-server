{% extends 'UI/layout/base.html.twig' %}

{% block content %}
<h1 class="text-xl font-semibold text-slate-800 mb-6">Tools</h1>
<div class="mb-6">
    {% include 'UI/_partial/info_box.html.twig' with {
        info: 'Encrypting personally identifiable results in event data being unreadable from inside the UI and database. Data can be decrypted using the corresponding private SSH key'
    } %}
</div>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm max-w-lg">
    <div class="px-6 py-4 border-b border-slate-200">
        <h4 class="text-sm font-semibold text-slate-700">Encrypt personally identifiable data</h4>
    </div>
    <div class="p-6">
        {{ form_start(form) }}
        <div class="mb-6">
            {{ form_label(form.beforeDate, null, { label_attr: { class: 'form-label' }}) }}
            {{ form_widget(form.beforeDate) }}
            {{ form_errors(form.beforeDate) }}
        </div>
        <button
            data-turbo-confirm="Are you sure you want to continue? This will encrypt all data recorded before the input date, flagged as sensitive data"
            type="submit"
            class="button button-primary">Encrypt</button>
        {{ form_end(form) }}
        <p class="mt-6 text-sm text-slate-600">
            <span class="font-semibold">Last performed:</span>
            {% if settings.lastSshKeyUpdate is defined %}
                {{ settings.lastSshKeyUpdate|date('jS M Y H:i') }}
            {% endif %}
        </p>
    </div>
</div>
{% endblock %}
