{% extends 'UI/layout/base.html.twig' %}

{% block content %}
    <div class="min-h-[60vh] flex items-center justify-center px-4 py-12">
        <div
            class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm p-8 w-full max-w-lg"
            data-controller="setup"
            data-setup-stream-url-value="{{ path('setup_run') }}"
            {% if isInstalled is defined and isInstalled %}data-setup-installed="1"{% endif %}
        >
            <div class="mb-6">
                <h1 class="text-xl font-semibold text-slate-800 dark:text-slate-100 mb-1">
                    First-time Setup
                    {% if isInstalled is defined and isInstalled %}
                        <span class="ml-2 inline-block text-xs font-medium px-2 py-0.5 rounded bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                            Installed
                        </span>
                    {% endif %}
                </h1>
                <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">
                    Run the steps below to configure your environment before using EventSourcerer.
                </p>
                <p class="mb-4 text-sm text-slate-500 dark:text-slate-400 mt-2">
                    To register the very first super user, run:
                    <code class="px-1 py-0.5 rounded bg-slate-100 dark:bg-slate-700">php bin/console app:user:register-first</code>
                </p>
            </div>

            <div class="flex gap-4 mb-6">
                <button
                    type="button"
                    class="button button-primary{% if isInstalled is defined and isInstalled %} hidden{% endif %}"
                    data-setup-target="runButton"
                    data-action="click->setup#run"
                >
                    Run Setup
                </button>

                <a href="{{ path('setup', {reset: 1}) }}" class="button button-secondary text-sm flex items-center">
                    Try again
                </a>
            </div>

            <div data-setup-target="status" class="hidden">
                <ul data-setup-target="steps" class="divide-y divide-slate-100 dark:divide-slate-700 list-none p-0 m-0"></ul>

                <div class="mt-8 flex justify-center">
                    <a
                        href="{{ path('dashboard') }}"
                        class="button button-primary{% if isInstalled is not defined or not isInstalled %} hidden{% endif %}"
                        data-setup-target="continueButton"
                    >
                        Continue to Dashboard
                    </a>
                </div>
            </div>

            <div data-setup-target="loginLink" class="hidden mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
                <p class="text-sm text-slate-600 dark:text-slate-300 mb-3">
                    Setup is complete. You can now log in to continue.
                </p>
                <a href="{{ path('app_login') }}" class="button button-primary inline-flex items-center">
                    Go to login
                </a>
            </div>
        </div>
    </div>
{% endblock %}
