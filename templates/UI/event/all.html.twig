{% extends 'UI/layout/base.html.twig' %}

{% block content %}
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <h1 class="text-xl font-semibold text-slate-800 dark:text-slate-100">Events</h1>
        <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3">
            {{ form_start(searchForm) }}
            <div class="flex gap-2">
                {{ form_widget(searchForm.search, {attr: {class: 'form-input w-full md:w-64'}}) }}
                <button type="submit" class="button button-secondary">Search</button>
            </div>
            {{ form_end(searchForm) }}
            {% if is_granted('ROLE_SUPER_USER') %}
                <a class="button button-secondary" href="{{ path('event_postman_collection') }}">
                    <i class="fa-solid fa-download mr-1"></i> Postman Collection
                </a>
                <a class="button button-primary" href="{{ path('register_event') }}">Register Event</a>
            {% endif %}
        </div>
    </div>

    {% if authors|length > 1 %}
        <div class="mb-6 flex flex-wrap gap-4 items-center bg-slate-50 p-4 rounded-lg border border-slate-200"
             data-controller="event-filter"
             data-event-filter-url-template-value="{{ path('events', {page: 1, search: search ?: 'EMPTY_SEARCH', authors: 'AUTHORS_PLACEHOLDER'})|raw }}"
             data-event-filter-frame-id-value="events-list">
            <span class="text-sm font-medium text-slate-600">Filter by Author:</span>
            {% for author in authors %}
                <label class="inline-flex items-center cursor-pointer group">
                    <input type="checkbox"
                           class="author-filter form-checkbox rounded text-emerald-600 focus:ring-emerald-500"
                           value="{{ author.id.toString() }}"
                           data-event-filter-target="checkbox"
                           data-action="change->event-filter#filter"
                           {% if author.id.toString() in selectedAuthorIds %}checked{% endif %}>
                    <span class="ml-2 text-sm text-slate-700 group-hover:text-slate-900">{{ author.name }}</span>
                </label>
            {% endfor %}
        </div>
    {% endif %}

    {% include 'UI/event/_events_list.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
