{% extends 'UI/layout/base.html.twig' %}

{% block content %}
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <h1 class="text-xl font-semibold text-slate-800 dark:text-slate-100">Events</h1>
        <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3">
            {{ form_start(searchForm) }}
            <div class="flex gap-2">
                {{ form_widget(searchForm.search, {attr: {class: 'form-input w-full md:w-64'}}) }}
                <button type="submit" class="button button-secondary">Search</button>
            </div>
            {{ form_end(searchForm) }}
            {% if is_granted('ROLE_SUPER_USER') %}
                <a class="button button-secondary" href="{{ path('event_postman_collection') }}">
                    <i class="fa-solid fa-download mr-1"></i> Postman Collection
                </a>
                <a class="button button-primary" href="{{ path('register_event') }}">Register Event</a>
            {% endif %}
        </div>
    </div>

    {% if search %}
        {% include 'UI/_partial/search_results_text.html.twig' with {search, count} %}
    {% endif %}

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="data-table">
            <thead>
            <tr>
                <th class="w-3/5 md:w-4/5">Name</th>
                <th>Version</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for event in events %}
                <tr>
                    <td class="w-3/5 font-medium text-slate-700">{{ event.name }}</td>
                    <td><span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-slate-100 text-slate-600">v{{ event.version }}</span></td>
                    <td class="text-right">
                        {% if not event.retired %}
                            <a class="text-slate-400 hover:text-emerald-600 transition-colors"
                               data-tippy-target="children"
                               data-tippy-content="Create new version of event"
                               href="{{ path('edit_event', {id: event.id}) }}">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                        {% else %}
                            <a class="text-slate-400 hover:text-slate-600 transition-colors"
                               data-tippy-target="children"
                               data-tippy-content="View legacy version of event"
                               href="{{ path('view_event', {id: event.id}) }}">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include 'UI/_partial/pagination.html.twig' with {pages, route: 'events', id: null} %}
    </div>
{% endblock %}
