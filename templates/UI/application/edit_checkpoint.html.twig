{% extends 'UI/layout/base.html.twig' %}
{% form_theme form 'form/main_theme.html.twig' %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold text-slate-800 dark:text-slate-100">Edit Checkpoint</h1>
        <a class="button button-secondary" href="{{ path('applications') }}">Back to Applications</a>
    </div>
    <div class="mb-6">
        {% include 'UI/_partial/info_box.html.twig' with {
            info: 'Edit stream checkpoint for application: ' ~ application.name
        } %}
    </div>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 max-w-lg">
        {{ form_errors(form) }}
        {{ form_start(form) }}
        <div class="mb-6">
            {{ form_widget(form.streamId) }}
            {{ form_widget(form.applicationId) }}
            {{ form_widget(form.checkpoint, { attr: { class: 'form-input' }}) }}
        </div>
        <button class="button button-primary" type="submit">Save</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
