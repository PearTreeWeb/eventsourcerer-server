{% extends 'UI/layout/base.html.twig' %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold text-slate-800 dark:text-slate-100">Users</h1>
        <a class="button button-primary" href="{{ path('create-user') }}">Create User</a>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="data-table">
            <thead>
            <tr>
                <th>Email</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td class="font-medium text-slate-700">{{ user.email }}</td>
                    <td>
                        <div class="flex space-x-4 justify-end">
                            <a class="text-slate-400 hover:text-emerald-600 transition-colors" href="{{ path('edit_user', {id: user.id}) }}">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>

                            {% if user.id is not same as(currentUser.id) %}
                                <a href="{{ path('delete_user', {id: user.id}) }}"
                                   data-tippy-content="Delete"
                                   data-tippy-target="children"
                                   data-turbo-method="delete"
                                   data-turbo-confirm="Are you sure you want to delete the user?"
                                >
                                    <i data-index="__name__"
                                       class="cursor-pointer fa-regular fa-trash-can"
                                    >
                                    </i>
                                </a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
