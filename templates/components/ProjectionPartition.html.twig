<div {{ attributes }} class="mt-10 p-4">
    <p class="text-slate-500 dark:text-slate-400 text-sm">Search by partition</p>

    <input
        class="my-4 w-full p-2 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 text-sm"
        type="search"
        placeholder="some-stream-00000000-0000-0000-0000-000000000000"
        data-model="streamId"
    >

    {% if this.projectionState %}
        <div>
            <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th class="px-6 py-3">Property</th>
                    <th class="px-6 py-3">Value</th>
                </tr>
                </thead>
                <tbody class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                    {% for key, value in this.projectionState.currentState %}
                        <tr>
                            <td class="px-6 py-3">{{ key }}</td>
                            <td class="px-6 py-3">{{ value }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
