{% extends 'UI/widget/template.html.twig' %}

{% block title %}
    {% include 'UI/widget/template_header.html.twig' with {icon: 'fa-ethernet'} %}
{% endblock %}

{% block content %}
    {% if events|length %}
        <table class="table-auto text-xs w-full text-slate-400">
            <tbody>
            {% for recentConnection in events %}
                {% set event = recentConnection.toScalarArray %}

                <tr class="even:bg-gray-50 hover:bg-gray-200">
                    <td class="p-2 text-lg">
                        {% if event.payload['application-type'] is same as('Laravel') %}
                            <i class="mr-4 text-red-400 fa-solid fa-bold fa-brands fa-laravel"></i>
                        {% elseif event.payload['application-type'] is same as('Symfony') %}
                            <i class="mr-4 text-black fa-solid fa-bold fa-brands fa-black fa-symfony"></i>
                        {% else %}
                            <i class="mr-4 fa-solid fa-question"></i>
                        {% endif %}
                    </td>
                    <td class="py-2">{{ event.payload['application-type'] }}</td>
                    <td class="py-2">{{ event.payload['ip-address'] }}</td>
                    <td class="py-2">{{ event.occurred|date('jS M H:i:s') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="text-sm text-slate-400">A widget showing recent connections</p>
    {% endif %}
{% endblock %}
